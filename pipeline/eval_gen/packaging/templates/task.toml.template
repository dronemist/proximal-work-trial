schema_version = "1.2"
artifacts = []

[task]
name = "worktrial/{task_name}"
description = "Generated eval task: replicate a {n_pages}-page {domain_label} design at desktop (1440px). Graded with per-page SSIM aggregated via cross-page harmonic mean × anticheat multiplier."
authors = []
keywords = ["design-to-code", "html-css", "generated", "multi-page", "{domain_keyword}"]

[metadata]
generated_by = "pipeline/eval_gen"
domain = "{domain_name}"
archetype = "{archetype_name}"
n_pages = {n_pages}

[verifier]
timeout_sec = 1200.0

[verifier.env]

[agent]
timeout_sec = 1800.0

[environment]
build_timeout_sec = 900.0
os = "linux"
cpus = 2
memory_mb = 4096
storage_mb = 10240
gpus = 0
allow_internet = true
mcp_servers = []

[environment.env]

[solution.env]
